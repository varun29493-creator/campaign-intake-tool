    emoji = {"Completed": "✅", "In Progress": "🔄", "Clarification Needed": "❓"}.get(submission.status, "📋")
    message = {"text": f"{emoji} *Campaign Status Update*\n*{submission.campaign_name}*\nStatus: {submission.status}\nID: `{submission.id}`"}
